# mcp-agent-mail: repo-scoped identity for this marketplace (direnv)
# Run `direnv allow` once after editing.

# Expose repo helpers (the `agent` wrapper) on PATH inside this repo only.
PATH_add scripts

# Durable default for MANUAL commits / shells that do not go through `agent`.
# Cursor workers launched via `scripts/agent` override this with a stable
# per-pane worker identity from Agent Mail.
# No coordinator role in this repo yet — do not set COORDINATOR_AGENT_NAME /
# IS_COORDINATOR / AGENT_MAIL_BYPASS here.
export AGENT_NAME="${AGENT_NAME:-TinyCedar}"
