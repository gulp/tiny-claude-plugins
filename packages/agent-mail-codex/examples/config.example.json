{
  "schemaVersion": 1,
  "statePath": "/tmp/agent-mail-codex-example.sqlite3",
  "bindings": {
    "example-project": {
      "agent": "CobaltJaguar",
      "mailScope": {
        "kind": "project",
        "projectPath": "/home/gulp/projects/tiny-claude-plugins"
      },
      "codex": {
        "adapter": "headless-app-server-owner",
        "ownership": "explicit-handoff",
        "threadId": "thread-example",
        "cwd": "/home/gulp/projects/tiny-claude-plugins",
        "transport": {
          "kind": "private-stdio"
        }
      },
      "delivery": {
        "batchWindowMs": 500,
        "maxEvents": 50,
        "maxBytes": 32768,
        "urgentDuringTurn": "steer",
        "routineDuringTurn": "queue"
      }
    }
  }
}
