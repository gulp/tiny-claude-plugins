# Per-binding environment for agent-mail-codex@.service
# Copy to ~/.config/agent-mail-codex/<binding>.env and edit absolute paths.

# Absolute path to schemaVersion=1 ingress config JSON.
AGENT_MAIL_CODEX_CONFIG=%h/.config/agent-mail-codex/config.json

# Canonical git-mailbox root (read-only for the supervisor).
AGENT_MAIL_MAILBOX_ROOT=%h/.mcp_agent_mail_git_mailbox_repo

# R1 shadow: observe + compare; no Codex delivery. Keep ENABLED unset/false.
# CODEX_INGRESS_SHADOW=1
# CODEX_INGRESS_ENABLED=false

# Optional: override deno / package root if not using the install layout.
# AGENT_MAIL_CODEX_ROOT=%h/.local/lib/agent-mail-codex
# DENO_BIN=%h/.local/bin/deno
