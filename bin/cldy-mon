#!/usr/bin/env bash
# cldy-mon — launch Claude Code with the `agent-mail-monitor` plugin armed for
# THIS session only ("monitor mode", opt-in / per-launch).
#
# Two ways to get the monitor:
#   1. Persistent (every session):  /plugin marketplace add <owner>/tiny-claude-plugins
#                                    /plugin install agent-mail-monitor
#   2. Sometimes (this session):    cldy-mon            ← you are here
#
# This shim resolves the sibling plugin dir and execs `claude --plugin-dir`, so
# the mail-inbox Monitor auto-arms for the launched session and goes away when
# it ends. No global install, no config file to remember to disable.
#
# The Monitor watches Agent Mail for $AGENT_NAME in $CLAUDE_PROJECT_DIR, so an
# identity is required for it to be useful — launch as:  AGENT_NAME=Foo cldy-mon
set -euo pipefail

self="$(readlink -f "$0")"
root="$(cd "$(dirname "$self")/.." && pwd)"
plugin="$root/plugins/agent-mail-monitor"

if [ ! -f "$plugin/.claude-plugin/plugin.json" ]; then
	echo "cldy-mon: plugin not found at $plugin (expected .claude-plugin/plugin.json)" >&2
	exit 1
fi
if ! command -v claude >/dev/null 2>&1; then
	echo "cldy-mon: 'claude' not found on PATH" >&2
	exit 127
fi
if [ -z "${AGENT_NAME:-}" ]; then
	echo "cldy-mon: note — AGENT_NAME is unset; the mail Monitor needs an identity to watch." >&2
	echo "         relaunch as:  AGENT_NAME=YourName cldy-mon $*" >&2
fi

exec claude --plugin-dir "$plugin" "$@"
