{
  "name": "@agent-mail/cli",
  "version": "0.5.0",
  "exports": "./src/cli.ts",
  "tasks": {
    "check": "deno check src/cli.ts",
    "watch": "deno run --allow-run=am --allow-env --allow-read src/cli.ts watch",
    "doctor": "deno run --allow-run=am --allow-env --allow-read src/cli.ts doctor",
    "monitor": "deno run --allow-run=am --allow-env --allow-read src/cli.ts monitor"
  },
  "imports": {
    "commander": "npm:commander@^14.0.0",
    "zod": "npm:zod@^3.23.8"
  },
  "compilerOptions": {
    "strict": true
  },
  "fmt": {
    "indentWidth": 2,
    "lineWidth": 100
  },
  "lint": {
    "rules": { "tags": ["recommended"] }
  }
}
